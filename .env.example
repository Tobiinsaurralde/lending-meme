# WalletConnect / Reown project id — get one at https://cloud.reown.com
# Copy this file to .env.local and paste the id below.
# Without it, injected wallets (MetaMask etc.) still work; WalletConnect-based
# wallets stay unavailable and the Deploy page reports that honestly.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Lending pool on Arc. Leave empty until LendingPool is deployed.
# The market reads balances either way and only sends a transaction when this is set.
NEXT_PUBLIC_LENDING_POOL=

# Developer request desk (DeveloperInbox) on Arc.
NEXT_PUBLIC_DEVELOPER_INBOX=0x2871504f88ce7e29cf023966e76d80ba66af2420

# NFT escrow on Arc. Leave empty until NftEscrow is deployed.
NEXT_PUBLIC_NFT_ESCROW=

# The Studio API (apps/studio, `npm run studio:api`). The Next server proxies /api/* to it.
STUDIO_API_URL=http://127.0.0.1:4310
